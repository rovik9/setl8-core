diff --git a/programs/core-vault/src/constants/limits.rs b/programs/core-vault/src/constants/limits.rs
index 2e0f65c..3f36d7a 100644
--- a/programs/core-vault/src/constants/limits.rs
+++ b/programs/core-vault/src/constants/limits.rs
@@ -70,3 +70,28 @@ pub const BOND_9M_TERM_SECS: i64 = 23_328_000;
 /// Hard lock of the nine-month bond: half the term (135 days).
 pub const BOND_9M_LOCK_SECS: i64 = 11_664_000;
 pub const BOND_9M_INTEREST_BPS: u16 = 3_000;
+
+/// Hard ceiling on `VaultState::open_claims_total` (the sum owed on every open claim)
+/// that `request_payout` enforces: 2^62 base units (about 4.6 trillion coins, far above
+/// all USDC and USDT in existence). Its job is arithmetic headroom, not policy: the
+/// counter is a `u64` and a sector chooses each amount, so without a ceiling one huge
+/// request makes every later `checked_add` overflow, which locks bond withdrawals too.
+/// Bond claims are NOT subject to it (they cannot be refused without locking bond
+/// holders in) and always fit above it: all open bonds are capped at
+/// `BOND_GLOBAL_CAP` principal, so their claims total at most 1.3 x that.
+pub const MAX_OPEN_CLAIMS_TOTAL: u64 = 1 << 62;
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_claims_ceiling_leaves_room_for_every_bond_the_caps_allow() {
+        // the sector fills to the ceiling, then every allowed bond is withdrawn at
+        // maturity with the larger (30%) interest: the sum must still fit in a u64
+        let bond_claims = BOND_GLOBAL_CAP as u128 * 130 / 100;
+        assert!((MAX_OPEN_CLAIMS_TOTAL as u128) + bond_claims < u64::MAX as u128);
+        assert_eq!(MAX_OPEN_CLAIMS_TOTAL, 4_611_686_018_427_387_904);
+    }
+}
+
