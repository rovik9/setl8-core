diff --git a/tests-rs/tests/claims_ceiling.rs b/tests-rs/tests/claims_ceiling.rs
new file mode 100644
index 0000000..da5c747
--- /dev/null
+++ b/tests-rs/tests/claims_ceiling.rs
@@ -0,0 +1,93 @@
+//! SR-21: `request_payout` used to accept any `u64` amount, so one request of ~u64::MAX
+//! (a sector bug or a malicious sector) saturated `open_claims_total` and from then on
+//! every `request_bond_payout` and every other `request_payout` failed with
+//! `MathOverflow`: bond holders could not exit. The vault now refuses a request that would
+//! take `open_claims_total` above `MAX_OPEN_CLAIMS_TOTAL` (2^62), which leaves ample
+//! headroom for bond claims (their total is bounded by ~$780K = 7.8e11 base units).
+mod common;
+use common::*;
+use core_vault::constants::{BOND_6M_LOCK_SECS, BOND_GLOBAL_CAP};
+use core_vault::errors::VaultError;
+use core_vault::state::BondTerm;
+use solana_signer::Signer;
+
+const M: u64 = 1_000_000;
+/// Hard-coded on purpose: the test pins the figure, not the constant's name.
+const CEILING: u64 = 1 << 62;
+
+fn rig() -> (Env, Sector) {
+    Env::registered(&Cfg { max_payout: 9, ..Cfg::default() })
+}
+
+#[test]
+fn a_request_near_u64_max_is_rejected_and_changes_nothing() {
+    let (mut e, s) = rig();
+    let w = wallet();
+    e.deposit(&s, &w, 1);
+    let ix = payout_ix(&e, &s, &w, 1, u64::MAX - 5, 1); // registers the claim address for the digest
+    let before = e.digest();
+    let reg = e.registry(&s);
+    assert_vault_err(&e.send(ix), VaultError::ClaimsCeilingExceeded);
+    assert_eq!(e.digest(), before, "a rejected request changes nothing");
+    assert_eq!(e.registry(&s).total_requests_emitted, reg.total_requests_emitted);
+    assert_eq!(e.trader(&s, &w, 1).payout_count, 0);
+}
+
+#[test]
+fn bond_holders_can_still_exit_after_a_hostile_request() {
+    let (mut e, s) = rig();
+    let k = e.new_depositor();
+    e.make_atas(&k.pubkey());
+    e.bond_deposit(&k, 0, 100 * M, BondTerm::SixMonths, Coin::Usdc);
+    let w = wallet();
+    e.deposit(&s, &w, 1);
+    // the hostile / buggy request is refused ...
+    let ix = payout_ix(&e, &s, &w, 1, u64::MAX - 5, 1);
+    assert_vault_err(&e.send(ix), VaultError::ClaimsCeilingExceeded);
+    // ... so the bond holder can withdraw
+    e.advance(BOND_6M_LOCK_SECS);
+    e.bond_request(&k, 0);
+    assert_eq!(e.bond_claim_opt(&k.pubkey(), 0).unwrap().owed, 100 * M - 200_000);
+    e.assert_claim_invariant();
+}
+
+#[test]
+fn exactly_the_ceiling_is_accepted_one_more_is_not_and_bonds_still_fit_on_top() {
+    let (mut e, s) = rig();
+    let (w1, w2) = (wallet(), wallet());
+    e.deposit(&s, &w1, 1);
+    e.deposit(&s, &w2, 1);
+    e.payout(&s, &w1, 1, CEILING, 1);
+    assert_eq!(e.vault_state().open_claims_total, CEILING);
+    let ix = payout_ix(&e, &s, &w2, 1, 1, 1);
+    assert_vault_err(&e.send(ix), VaultError::ClaimsCeilingExceeded);
+    // a bond holder can still exit with the claims sitting AT the ceiling
+    let k = e.new_depositor();
+    e.make_atas(&k.pubkey());
+    e.bond_deposit(&k, 0, 100 * M, BondTerm::SixMonths, Coin::Usdc);
+    e.advance(BOND_6M_LOCK_SECS);
+    e.bond_request(&k, 0);
+    assert_eq!(e.vault_state().open_claims_total, CEILING + 100 * M - 200_000);
+    e.assert_claim_invariant();
+}
+
+#[test]
+fn the_ceiling_leaves_room_for_every_bond_the_caps_allow() {
+    // worst case: the sector fills to the ceiling, then EVERY allowed bond is withdrawn at
+    // maturity with 30% interest (the 9-month rate)
+    let bond_claims = BOND_GLOBAL_CAP as u128 * 130 / 100;
+    assert!(CEILING as u128 + bond_claims < u64::MAX as u128);
+}
+
+#[test]
+fn a_request_below_the_ceiling_still_works_for_another_product() {
+    let (mut e, s) = rig();
+    let s2 = Sector::new();
+    e.register(&s2, &Cfg::default());
+    let (w1, w2) = (wallet(), wallet());
+    e.deposit(&s, &w1, 1);
+    e.deposit(&s2, &w2, 1);
+    e.payout(&s, &w1, 1, CEILING - 10, 1);
+    e.payout(&s2, &w2, 1, 10, 1); // exactly fills it
+    assert_eq!(e.vault_state().open_claims_total, CEILING);
+}
